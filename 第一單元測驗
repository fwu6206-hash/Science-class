const Confetti = () => {
    const canvasRef = useRef(null);
    useEffect(() => {
        const canvas = canvasRef.current;
        if (!canvas) return;
        const ctx = canvas.getContext('2d');
        if (!ctx) return;
        let animationFrameId;
        const resizeCanvas = () => {
            canvas.width = window.innerWidth;
            canvas.height = window.innerHeight;
        };
        resizeCanvas();
        window.addEventListener('resize', resizeCanvas);
        
        const particles = [];
        const colors = ['#fce7f3', '#fef08a', '#bbf7d0', '#bfdbfe', '#fbcfe8', '#f87171', '#fbbf24'];

        for (let i = 0; i < 150; i++) {
            particles.push({
                x: canvas.width / 2,
                y: canvas.height / 2 + 100,
                r: Math.random() * 6 + 2,
                dx: Math.random() * 20 - 10,
                dy: Math.random() * -20 - 5,
                color: colors[Math.floor(Math.random() * colors.length)],
                gravity: 0.5,
                life: 1
            });
        }

        const animate = () => {
            ctx.clearRect(0, 0, canvas.width, canvas.height);
            let active = false;
            particles.forEach(p => {
                if (p.life > 0) {
                    active = true;
                    ctx.beginPath();
                    ctx.arc(p.x, p.y, p.r, 0, Math.PI * 2);
                    ctx.fillStyle = p.color;
                    ctx.globalAlpha = p.life;
                    ctx.fill();
                    p.x += p.dx;
                    p.y += p.dy;
                    p.dy += p.gravity;
                    p.life -= 0.01;
                }
            });
            if (active) {
                animationFrameId = requestAnimationFrame(animate);
            }
        };
        animate();

        return () => {
            window.removeEventListener('resize', resizeCanvas);
            cancelAnimationFrame(animationFrameId);
        };
    }, []);

    return <canvas ref={canvasRef} className="fixed inset-0 pointer-events-none z-50"></canvas>;
};

const MatchingQuestion = ({ data, onCorrect, onWrong }) => {
    const [selectedLeft, setSelectedLeft] = useState(null);
    const [matches, setMatches] = useState([]);
    const [error, setError] = useState(false);

    const handleLeftClick = (item) => {
        if (matches.find(m => m.left === item.id)) return;
        setSelectedLeft(item);
        setError(false);
    };

    const handleRightClick = (item) => {
        if (matches.find(m => m.right === item.id)) return;
        if (!selectedLeft) return;

        if (item.match === selectedLeft.id) {
            const newMatches = [...matches, { left: selectedLeft.id, right: item.id }];
            setMatches(newMatches);
            setSelectedLeft(null);
            
            if (newMatches.length === data.left.length) {
                setTimeout(() => onCorrect(), 1000);
            }
        } else {
            setError(true);
            if (onWrong) onWrong();
            setTimeout(() => setError(false), 800);
            setSelectedLeft(null);
        }
    };

    return (
        <div className="w-full max-w-2xl mx-auto bg-white p-6 rounded-2xl shadow-lg border-4 border-blue-200">
            <h3 className="text-2xl font-bold text-gray-800 mb-6 text-center">{data.question}</h3>
            <div className="flex flex-col md:flex-row justify-between gap-4">
                <div className="flex flex-col gap-4 w-full md:w-1/2">
                    {data.left.map(item => {
                        const isMatched = matches.find(m => m.left === item.id);
                        const isSelected = selectedLeft?.id === item.id;
                        return (
                            <button key={item.id} onClick={() => handleLeftClick(item)}
                                className={`p-4 text-lg font-bold rounded-xl border-4 transition-all ${
                                    isMatched ? 'bg-green-100 border-green-500 text-green-700 opacity-50' :
                                    isSelected ? 'bg-blue-100 border-blue-500 shadow-md scale-105' :
                                    'bg-gray-50 border-gray-200 hover:border-blue-300'
                                }`}>
                                {item.text} {isMatched && '✅'}
                            </button>
                        );
                    })}
                </div>
                <div className="flex flex-col gap-4 w-full md:w-1/2">
                    {data.right.map(item => {
                        const isMatched = matches.find(m => m.right === item.id);
                        return (
                            <button key={item.id} onClick={() => handleRightClick(item)}
                                className={`p-4 text-lg font-bold rounded-xl border-4 transition-all ${
                                    isMatched ? 'bg-green-100 border-green-500 text-green-700 opacity-50' :
                                    error && selectedLeft ? 'hover:bg-red-100 hover:border-red-400' :
                                    selectedLeft ? 'hover:bg-yellow-100 hover:border-yellow-400 cursor-pointer animate-pulse' :
                                    'bg-gray-50 border-gray-200'
                                }`}>
                                {item.text}
                            </button>
                        );
                    })}
                </div>
            </div>
            {error && <p className="text-red-500 text-center mt-4 font-bold animate-bounce">哎呀！連錯了，再試一次！</p>}
        </div>
    );
};

const CombinationQuestion = ({ data, onCorrect, onWrong }) => {
    const [selected, setSelected] = useState([]);
    const [error, setError] = useState(false);

    const handleSelect = (index) => {
        if (selected.includes(index)) return;
        const newSelected = [...selected, index];
        setSelected(newSelected);
        setError(false);

        if (newSelected.length === data.answer.length) {
            const isCorrect = newSelected.every((val, i) => val === data.answer[i]);
            if (isCorrect) {
                setTimeout(() => onCorrect(), 1000);
            } else {
                setError(true);
                if (onWrong) onWrong();
                setTimeout(() => {
                    setSelected([]);
                    setError(false);
                }, 1200);
            }
        }
    };

    return (
        <div className="w-full max-w-2xl mx-auto bg-white p-6 rounded-2xl shadow-lg border-4 border-yellow-200">
            <h3 className="text-2xl font-bold text-gray-800 mb-6 text-center">{data.question}</h3>
            
            <div className="flex gap-2 justify-center mb-8 min-h-[60px] flex-wrap">
                {data.answer.map((_, i) => (
                    <div key={i} className={`flex-1 min-w-[100px] max-w-[150px] border-4 border-dashed rounded-xl flex items-center justify-center p-2 font-bold text-center
                        ${selected[i] !== undefined ? 'border-green-400 bg-green-50' : 'border-gray-300'}`}>
                        {selected[i] !== undefined ? data.options[selected[i]] : '?'}
                    </div>
                ))}
            </div>

            <div className="flex flex-wrap gap-4 justify-center">
                {data.options.map((opt, i) => (
                    <button key={i} onClick={() => handleSelect(i)} disabled={selected.includes(i)}
                        className={`px-6 py-3 text-lg font-bold rounded-full border-4 shadow-sm transition-all
                        ${selected.includes(i) ? 'bg-gray-200 border-gray-300 text-gray-400 opacity-50 cursor-not-allowed' : 'bg-yellow-100 border-yellow-400 hover:scale-105 active:scale-95 text-yellow-800'}`}>
                        {opt}
                    </button>
                ))}
            </div>

            {error && <p className="text-red-500 text-center mt-6 font-bold text-xl animate-bounce">順序不對喔！重新排列看看。</p>}
            <div className="text-center mt-4">
                <button onClick={() => {setSelected([]); setError(false);}} className="text-sm text-gray-500 underline hover:text-gray-800">重設</button>
            </div>
        </div>
    );
};

const QuizEngine = ({ activityId, data, onComplete, onAddScore, onGoHome }) => {
    const [currentIndex, setCurrentIndex] = useState(0);
    const [showFeedback, setShowFeedback] = useState(false);
    const [feedbackType, setFeedbackType] = useState('success');
    const [questionAttempts, setQuestionAttempts] = useState(0);
    const [earnedPointsDisplay, setEarnedPointsDisplay] = useState(0);
    const [randomizedData, setRandomizedData] = useState([]);
    
    // 動態抽題邏輯：保證每種題型都有，且達到指定總數
    useEffect(() => {
        const totalQuestions = activityId === 4 ? 10 : 15; // 素養10題，其他15題
        let selection = [];
        
        // 確保抽到至少一題各種題型
        const types = ['tf', 'mcq', 'matching', 'combination'];
        types.forEach(t => {
            const qOfType = data.filter(q => q.type === t).sort(() => 0.5 - Math.random());
            if (qOfType.length > 0) selection.push(qOfType[0]);
        });
        
        // 補足剩餘題數
        const remainingPool = data.filter(q => !selection.includes(q)).sort(() => 0.5 - Math.random());
        const needed = totalQuestions - selection.length;
        if (needed > 0) {
            selection = [...selection, ...remainingPool.slice(0, needed)];
        }
        
        // 最終打亂順序
        setRandomizedData(selection.sort(() => 0.5 - Math.random()));
    }, [data, activityId]);

    const currentQ = randomizedData[currentIndex];

    if (!currentQ) return <div className="text-center mt-20 text-2xl font-bold">載入題目中...</div>;

    const handleCorrect = () => {
        let points = 10;
        if (questionAttempts === 1) points = 7;
        else if (questionAttempts >= 2) points = 4;
        
        setEarnedPointsDisplay(points);
        setFeedbackType('success');
        setShowFeedback(true);
        onAddScore(points);
        
        setTimeout(() => {
            setShowFeedback(false);
            setQuestionAttempts(0);
            if (currentIndex < randomizedData.length - 1) {
                setCurrentIndex(currentIndex + 1);
            } else {
                onComplete(activityId);
            }
        }, 1500);
    };

    const handleWrong = () => {
        setQuestionAttempts(prev => prev + 1);
        setFeedbackType('error');
        setShowFeedback(true);
        setTimeout(() => setShowFeedback(false), 1500);
    };

    const renderQuestion = () => {
        if (currentQ.type === 'tf') {
            return (
                <div className="p-6 sm:p-8 bg-white rounded-3xl shadow-xl border-4 border-purple-200 animate-in zoom-in duration-300 text-center">
                    <div className="text-6xl mb-4">{currentQ.image || "❓"}</div>
                    <h2 className="text-xl sm:text-2xl font-bold text-gray-800 mb-8 leading-relaxed">{currentQ.question}</h2>
                    <div className="flex justify-center gap-6">
                        <button onClick={() => currentQ.answer === true ? handleCorrect() : handleWrong()}
                            className="flex-1 max-w-[200px] bg-green-50 hover:bg-green-100 border-4 border-green-400 text-green-700 font-black p-6 rounded-2xl text-2xl transition-transform hover:scale-105 active:scale-95 shadow-sm">
                            <div className="text-4xl mb-2">⭕</div>正確
                        </button>
                        <button onClick={() => currentQ.answer === false ? handleCorrect() : handleWrong()}
                            className="flex-1 max-w-[200px] bg-red-50 hover:bg-red-100 border-4 border-red-400 text-red-700 font-black p-6 rounded-2xl text-2xl transition-transform hover:scale-105 active:scale-95 shadow-sm">
                            <div className="text-4xl mb-2">❌</div>錯誤
                        </button>
                    </div>
                </div>
            );
        }

        if (currentQ.type === 'mcq') {
            return (
                <div className="p-4 sm:p-8 bg-white rounded-3xl shadow-xl border-4 border-blue-200 animate-in zoom-in duration-300">
                    <h2 className="text-xl sm:text-2xl font-bold text-gray-800 mb-6">{currentQ.question}</h2>
                    <div className="grid grid-cols-1 sm:grid-cols-2 gap-4">
                        {currentQ.options.map((opt, idx) => (
                            <button key={idx} onClick={() => idx === currentQ.answer ? handleCorrect() : handleWrong()}
                                className="bg-blue-50 hover:bg-blue-100 border-4 border-blue-200 text-blue-900 font-bold p-4 rounded-2xl text-left text-lg transition-transform hover:scale-105 active:scale-95 flex items-center">
                                <span className="shrink-0 inline-block bg-blue-300 text-white w-8 h-8 rounded-full text-center leading-8 mr-3">{['A','B','C','D'][idx]}</span>
                                <span>{opt}</span>
                            </button>
                        ))}
                    </div>
                </div>
            );
        }

        if (currentQ.type === 'matching') return <MatchingQuestion data={currentQ} onCorrect={handleCorrect} onWrong={handleWrong} />;
        if (currentQ.type === 'combination') return <CombinationQuestion data={currentQ} onCorrect={handleCorrect} onWrong={handleWrong} />;
    };

    return (
        <div className="relative max-w-4xl mx-auto w-full px-4 pt-16 sm:pt-10">
            <button onClick={onGoHome} className="absolute top-0 left-4 sm:top-4 bg-white px-4 py-2 rounded-full shadow font-bold text-gray-600 hover:bg-gray-100 border-2 border-gray-200 flex items-center">
                <Home className="w-4 h-4 mr-2" /> 回首頁
            </button>
            <div className="mb-8 mt-4 sm:mt-0">
                <div className="flex justify-between text-sm font-bold text-gray-600 mb-2">
                    <span>挑戰進行中</span>
                    <span>{currentIndex + 1} / {randomizedData.length}</span>
                </div>
                <div className="w-full bg-gray-200 rounded-full h-4">
                    <div className="bg-green-500 h-4 rounded-full transition-all duration-500" style={{width: `${((currentIndex + 1) / randomizedData.length) * 100}%`}}></div>
                </div>
            </div>

            {renderQuestion()}

            {showFeedback && (
                <div className={`fixed inset-0 flex items-center justify-center z-40 bg-white/80 backdrop-blur-sm ${feedbackType==='error'?'animate-bounce':''}`}>
                    <div className={`p-8 rounded-3xl shadow-2xl transform scale-110 flex flex-col items-center ${feedbackType === 'success' ? 'bg-green-100 border-4 border-green-500' : 'bg-red-100 border-4 border-red-500'}`}>
                        {feedbackType === 'success' ? (
                            <>
                                <CheckCircle className="text-green-500 w-16 h-16 mb-4" />
                                <h2 className="text-3xl font-bold text-green-700">太棒了！答對囉！</h2>
                                <p className="text-xl text-green-600 mt-2 font-bold">獲得 {earnedPointsDisplay} 分</p>
                            </>
                        ) : (
                            <>
                                <XCircle className="text-red-500 w-16 h-16 mb-4" />
                                <h2 className="text-3xl font-bold text-red-700">再想想看喔！</h2>
                            </>
                        )}
                    </div>
                </div>
            )}
        </div>
    );
};

