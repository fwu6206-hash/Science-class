                                            <td className="p-4"><span className="bg-gray-200 px-3 py-1 rounded-full text-sm text-gray-700 font-bold">{student.team}</span></td>
                                            <td className="p-4 text-center font-semibold text-gray-600">{student.score_1 || 0}</td>
                                            <td className="p-4 text-center font-semibold text-gray-600">{student.score_2 || 0}</td>
                                            <td className="p-4 text-center font-semibold text-gray-600">{student.score_3 || 0}</td>
                                            <td className="p-4 text-center font-semibold text-gray-600">{student.score_4 || 0}</td>
                                            <td className="p-4 font-black text-green-600 text-right text-xl">{student.total || 0}</td>
                                        </tr>
                                    ))}
                                    {leaderboard.length === 0 && (
                                        <tr><td colSpan="10" className="p-8 text-center text-gray-400 font-bold text-lg">目前還沒有學生紀錄，等待學生登入挑戰！</td></tr>
                                    )}
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
        );
    }

    return null;
}
